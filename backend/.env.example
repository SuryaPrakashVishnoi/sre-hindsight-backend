# ---- App ----
APP_ENV=development            # development | test | production
SEED_DEMO_DATA=true            # loads INC-001 / INC-104 demo incidents (never in production)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Groq ----
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Hindsight ----
HINDSIGHT_API_URL=
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=college-infrastructure

# ---- GitHub ----
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_REPOSITORY=             # owner/repo

# ---- Deployment providers ----
RENDER_API_KEY=
RENDER_SERVICE_ID=
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
DEPLOYMENT_SERVICE_NAME=Application
MOCK_DEPLOYMENTS=true
